{
  "name": "amerlol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test:secret-santa": "node --experimental-strip-types --test tests/secret-santa.test.mjs",
    "test:football-deepcuts": "node --experimental-strip-types --test tests/football-deepcuts.test.mjs",
    "generate:deepcuts-data": "node scripts/generate-deepcuts-database.mjs",
    "validate:deepcuts-data": "node scripts/validate-deepcuts-database.mjs",
    "check:deepcuts": "npm run validate:deepcuts-data && npm run test:football-deepcuts && npm run typecheck && npm run build",
    "test:foundation": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-amerlol-audit --config firebase.test.json \"vitest run --config vitest.rules.config.mts\"",
    "generate:settings-rules": "node --experimental-strip-types scripts/generate-settings-rules.mjs",
    "check:settings-rules": "node --experimental-strip-types scripts/generate-settings-rules.mjs --check",
    "check:foundation": "npm run check:settings-rules && npm run format:check && npm run lint && npm run typecheck && npm run test:foundation && npm run test:secret-santa && npm run test:football-deepcuts && npm run validate:deepcuts-data && npm run build",
    "refresh:deepcuts-rosters": "node scripts/refresh-deepcuts-rosters.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "firebase": "^12.19.0",
    "framer-motion": "^11.3.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.400.0",
    "maplibre-gl": "^6.14.0",
    "next": "^16.4.2",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "firebase-tools": "^15.34.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.38",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "postcss-selector-parser": "^7.1.6",
    "@opentelemetry/core": "^2.8.0",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
