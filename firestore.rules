rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isDeepcutsPoints(value) {
      return value is int && value in [0, 10, 30, 60, 85, 100];
    }
    function preferenceKeys() {
      return request.method == 'create' ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys();
    }
    function isPreferenceWrite(userId, settingsId, fields) {
      return request.auth != null && request.auth.uid == userId && settingsId == 'default' &&
        preferenceKeys().hasOnly(fields.concat(['createdAt', 'updatedAt'])) &&
        request.resource.data.updatedAt == request.time &&
        (request.method == 'create' || !preferenceKeys().hasAny(['createdAt']));
    }
    // Users can only read/write their own data
    // Document structure: /users/{userId}
    // Fields: username, email, displayName, createdAt, updatedAt
    // Security: Only the authenticated user whose UID matches the document ID can access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Encryption settings subcollection
      // Document structure: /users/{userId}/encryptionSettings/{settingsId}
      match /encryptionSettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["autoConvert","clearOnTabChange","defaultTab","fontSize"]) &&
          (!preferenceKeys().hasAny(["autoConvert"]) || (request.resource.data.autoConvert is bool)) &&
          (!preferenceKeys().hasAny(["clearOnTabChange"]) || (request.resource.data.clearOnTabChange is bool)) &&
          (!preferenceKeys().hasAny(["defaultTab"]) || (request.resource.data.defaultTab is string && request.resource.data.defaultTab in ["base64","url","hex","binary","ascii","caesar","rot13","morse","md5","sha256"])) &&
          (!preferenceKeys().hasAny(["fontSize"]) || (request.resource.data.fontSize is int && request.resource.data.fontSize >= 10 && request.resource.data.fontSize <= 24));
        allow delete: if false;
      }
      
      // Diff Checker settings subcollection
      // Document structure: /users/{userId}/diffCheckerSettings/{settingsId}
      match /diffCheckerSettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["fontSize","showLineNumbers","ignoreWhitespace","ignoreCase"]) &&
          (!preferenceKeys().hasAny(["fontSize"]) || (request.resource.data.fontSize is int && request.resource.data.fontSize >= 10 && request.resource.data.fontSize <= 24)) &&
          (!preferenceKeys().hasAny(["showLineNumbers"]) || (request.resource.data.showLineNumbers is bool)) &&
          (!preferenceKeys().hasAny(["ignoreWhitespace"]) || (request.resource.data.ignoreWhitespace is bool)) &&
          (!preferenceKeys().hasAny(["ignoreCase"]) || (request.resource.data.ignoreCase is bool));
        allow delete: if false;
      }
      
      // Time Zone Converter settings subcollection
      // Document structure: /users/{userId}/timezoneSettings/{settingsId}
      match /timezoneSettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["timeFormat","showSeconds","showDayNight","autoRefresh","defaultTimeZones"]) &&
          (!preferenceKeys().hasAny(["timeFormat"]) || (request.resource.data.timeFormat is string && request.resource.data.timeFormat in ["12","24"])) &&
          (!preferenceKeys().hasAny(["showSeconds"]) || (request.resource.data.showSeconds is bool)) &&
          (!preferenceKeys().hasAny(["showDayNight"]) || (request.resource.data.showDayNight is bool)) &&
          (!preferenceKeys().hasAny(["autoRefresh"]) || (request.resource.data.autoRefresh is bool)) &&
          (!preferenceKeys().hasAny(["defaultTimeZones"]) || (request.resource.data.defaultTimeZones is list && request.resource.data.defaultTimeZones.size() >= 1 && request.resource.data.defaultTimeZones.size() <= 12 && (request.resource.data.defaultTimeZones.size() <= 0 || (request.resource.data.defaultTimeZones[0] is string && request.resource.data.defaultTimeZones[0].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 1 || (request.resource.data.defaultTimeZones[1] is string && request.resource.data.defaultTimeZones[1].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 2 || (request.resource.data.defaultTimeZones[2] is string && request.resource.data.defaultTimeZones[2].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 3 || (request.resource.data.defaultTimeZones[3] is string && request.resource.data.defaultTimeZones[3].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 4 || (request.resource.data.defaultTimeZones[4] is string && request.resource.data.defaultTimeZones[4].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 5 || (request.resource.data.defaultTimeZones[5] is string && request.resource.data.defaultTimeZones[5].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 6 || (request.resource.data.defaultTimeZones[6] is string && request.resource.data.defaultTimeZones[6].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 7 || (request.resource.data.defaultTimeZones[7] is string && request.resource.data.defaultTimeZones[7].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 8 || (request.resource.data.defaultTimeZones[8] is string && request.resource.data.defaultTimeZones[8].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 9 || (request.resource.data.defaultTimeZones[9] is string && request.resource.data.defaultTimeZones[9].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 10 || (request.resource.data.defaultTimeZones[10] is string && request.resource.data.defaultTimeZones[10].size() <= 100)) && (request.resource.data.defaultTimeZones.size() <= 11 || (request.resource.data.defaultTimeZones[11] is string && request.resource.data.defaultTimeZones[11].size() <= 100))));
        allow delete: if false;
      }
      
      // Pickup Soccer settings subcollection
      // Document structure: /users/{userId}/pickupSoccerSettings/{settingsId}
      match /pickupSoccerSettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["defaultMaxPlayers","defaultLocation","showMyGamesOnly","autoJoin"]) &&
          (!preferenceKeys().hasAny(["defaultMaxPlayers"]) || (request.resource.data.defaultMaxPlayers is int && request.resource.data.defaultMaxPlayers >= 2 && request.resource.data.defaultMaxPlayers <= 100)) &&
          (!preferenceKeys().hasAny(["defaultLocation"]) || (request.resource.data.defaultLocation is string && request.resource.data.defaultLocation.size() <= 200)) &&
          (!preferenceKeys().hasAny(["showMyGamesOnly"]) || (request.resource.data.showMyGamesOnly is bool)) &&
          (!preferenceKeys().hasAny(["autoJoin"]) || (request.resource.data.autoJoin is bool));
        allow delete: if false;
      }
      
      // Secret Santa settings subcollection
      // Document structure: /users/{userId}/secretSantaSettings/{settingsId}
      match /secretSantaSettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["defaultBudget","showMyExchangesOnly"]) &&
          (!preferenceKeys().hasAny(["defaultBudget"]) || (request.resource.data.defaultBudget is string && request.resource.data.defaultBudget.size() <= 50)) &&
          (!preferenceKeys().hasAny(["showMyExchangesOnly"]) || (request.resource.data.showMyExchangesOnly is bool));
        allow delete: if false;
      }
      
      // Football Manager Team Picker settings subcollection
      // Document structure: /users/{userId}/footballManagerTeamPickerSettings/{settingsId}
      match /footballManagerTeamPickerSettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["defaultPickMode","defaultNumPicks","defaultMinTier","defaultSameCountry","defaultSameLeague","autoAddToHistory","showFavoritesOnly"]) &&
          (!preferenceKeys().hasAny(["defaultPickMode"]) || (request.resource.data.defaultPickMode is string && request.resource.data.defaultPickMode in ["single","multiple"])) &&
          (!preferenceKeys().hasAny(["defaultNumPicks"]) || (request.resource.data.defaultNumPicks is int && request.resource.data.defaultNumPicks >= 2 && request.resource.data.defaultNumPicks <= 20)) &&
          (!preferenceKeys().hasAny(["defaultMinTier"]) || (request.resource.data.defaultMinTier is int && request.resource.data.defaultMinTier >= 0 && request.resource.data.defaultMinTier <= 3)) &&
          (!preferenceKeys().hasAny(["defaultSameCountry"]) || (request.resource.data.defaultSameCountry is bool)) &&
          (!preferenceKeys().hasAny(["defaultSameLeague"]) || (request.resource.data.defaultSameLeague is bool)) &&
          (!preferenceKeys().hasAny(["autoAddToHistory"]) || (request.resource.data.autoAddToHistory is bool)) &&
          (!preferenceKeys().hasAny(["showFavoritesOnly"]) || (request.resource.data.showFavoritesOnly is bool));
        allow delete: if false;
      }
      
      // Football Manager Team Picker favorites subcollection
      // Document structure: /users/{userId}/footballManagerTeamPickerFavorites/{teamId}
      match /footballManagerTeamPickerFavorites/{teamId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Football Manager Team Picker history subcollection
      // Document structure: /users/{userId}/footballManagerTeamPickerHistory/{historyId}
      match /footballManagerTeamPickerHistory/{historyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Color Palette Crafter settings subcollection
      // Document structure: /users/{userId}/colorPaletteCrafterSettings/{settingsId}
      match /colorPaletteCrafterSettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["defaultColors","showColorCodes","autoCopyOnClick","defaultExportFormat","showLikes"]) &&
          (!preferenceKeys().hasAny(["defaultColors"]) || (request.resource.data.defaultColors is int && request.resource.data.defaultColors >= 2 && request.resource.data.defaultColors <= 8)) &&
          (!preferenceKeys().hasAny(["showColorCodes"]) || (request.resource.data.showColorCodes is bool)) &&
          (!preferenceKeys().hasAny(["autoCopyOnClick"]) || (request.resource.data.autoCopyOnClick is bool)) &&
          (!preferenceKeys().hasAny(["defaultExportFormat"]) || (request.resource.data.defaultExportFormat is string && request.resource.data.defaultExportFormat in ["hex","rgb","json"])) &&
          (!preferenceKeys().hasAny(["showLikes"]) || (request.resource.data.showLikes is bool));
        allow delete: if false;
      }
      
      // Color Palette Crafter favorites subcollection
      // Document structure: /users/{userId}/colorPaletteCrafterFavorites/{paletteId}
      match /colorPaletteCrafterFavorites/{paletteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Amer Gauntlet settings subcollection
      // Document structure: /users/{userId}/amerGauntletSettings/{settingsId}
      match /amerGauntletSettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["showTimer","showHints","animations","autoSubmit"]) &&
          (!preferenceKeys().hasAny(["showTimer"]) || (request.resource.data.showTimer is bool)) &&
          (!preferenceKeys().hasAny(["showHints"]) || (request.resource.data.showHints is bool)) &&
          (!preferenceKeys().hasAny(["animations"]) || (request.resource.data.animations is bool)) &&
          (!preferenceKeys().hasAny(["autoSubmit"]) || (request.resource.data.autoSubmit is bool));
        allow delete: if false;
      }
      
      // Amer Gauntlet results subcollection
      // Document structure: /users/{userId}/amerGauntletResults/{date}
      match /amerGauntletResults/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Amer Gauntlet stats subcollection
      // Document structure: /users/{userId}/amerGauntletStats/{statsId}
      match /amerGauntletStats/{statsId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // STL Monitor settings subcollection
      // Document structure: /users/{userId}/stlMonitorSettings/{settingsId}
      match /stlMonitorSettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["defaultCategories","defaultSeverityRange","defaultTimeWindow","autoRefresh","refreshInterval","mapStyle"]) &&
          (!preferenceKeys().hasAny(["defaultCategories"]) || (request.resource.data.defaultCategories is map && ("traffic" in request.resource.data.defaultCategories && request.resource.data.defaultCategories.traffic is bool) && ("weather" in request.resource.data.defaultCategories && request.resource.data.defaultCategories.weather is bool) && ("transit" in request.resource.data.defaultCategories && request.resource.data.defaultCategories.transit is bool) && ("news" in request.resource.data.defaultCategories && request.resource.data.defaultCategories.news is bool) && ("crime" in request.resource.data.defaultCategories && request.resource.data.defaultCategories.crime is bool))) &&
          (!preferenceKeys().hasAny(["defaultSeverityRange"]) || (request.resource.data.defaultSeverityRange is list && request.resource.data.defaultSeverityRange.size() == 2 && (request.resource.data.defaultSeverityRange[0] is int && request.resource.data.defaultSeverityRange[0] >= 0 && request.resource.data.defaultSeverityRange[0] <= 100) && (request.resource.data.defaultSeverityRange[1] is int && request.resource.data.defaultSeverityRange[1] >= 0 && request.resource.data.defaultSeverityRange[1] <= 100) && request.resource.data.defaultSeverityRange[0] <= request.resource.data.defaultSeverityRange[1])) &&
          (!preferenceKeys().hasAny(["defaultTimeWindow"]) || (request.resource.data.defaultTimeWindow is string && request.resource.data.defaultTimeWindow in ["15m","1h","6h","24h"])) &&
          (!preferenceKeys().hasAny(["autoRefresh"]) || (request.resource.data.autoRefresh is bool)) &&
          (!preferenceKeys().hasAny(["refreshInterval"]) || (request.resource.data.refreshInterval is int && request.resource.data.refreshInterval >= 15 && request.resource.data.refreshInterval <= 300)) &&
          (!preferenceKeys().hasAny(["mapStyle"]) || (request.resource.data.mapStyle is string && request.resource.data.mapStyle in ["dark","light"]));
        allow delete: if false;
      }
      
      // STL Monitor saved locations subcollection
      // Document structure: /users/{userId}/stlMonitorSavedLocations/{locationId}
      match /stlMonitorSavedLocations/{locationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // LMGTFY settings subcollection
      // Document structure: /users/{userId}/lmgtfySettings/{settingsId}
      match /lmgtfySettings/{settingsId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if isPreferenceWrite(userId, settingsId, ["defaultAnimationSpeed","redirectDelay","showQueryInAnimation"]) &&
          (!preferenceKeys().hasAny(["defaultAnimationSpeed"]) || (request.resource.data.defaultAnimationSpeed is number && request.resource.data.defaultAnimationSpeed >= 0.5 && request.resource.data.defaultAnimationSpeed <= 2)) &&
          (!preferenceKeys().hasAny(["redirectDelay"]) || (request.resource.data.redirectDelay is int && request.resource.data.redirectDelay >= 0 && request.resource.data.redirectDelay <= 10000)) &&
          (!preferenceKeys().hasAny(["showQueryInAnimation"]) || (request.resource.data.showQueryInAnimation is bool));
        allow delete: if false;
      }
      
      // Stickr (Panini sticker tracker) settings
      // Document structure: /users/{userId}/stickrSettings/{settingsId}
      match /stickrSettings/{settingsId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Deepcuts results and statistics are written only by trusted server code.
      // Client access stays closed until the backend exposes narrowly scoped reads.
      match /footballDeepcutsResults/{resultId} {
        allow read, write: if false;
      }

      match /footballDeepcutsStats/{statsId} {
        allow read, write: if false;
      }

      // Deepcuts completed games are immutable and keyed by UTC date.
      match /deepcutsResults/{date} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['date', 'score', 'answers', 'createdAt']) &&
          request.resource.data.date == date &&
          request.resource.data.score is int &&
          request.resource.data.score >= 0 && request.resource.data.score <= 500 &&
          request.resource.data.answers is list && request.resource.data.answers.size() == 5 &&
          isDeepcutsPoints(request.resource.data.answers[0].points) &&
          isDeepcutsPoints(request.resource.data.answers[1].points) &&
          isDeepcutsPoints(request.resource.data.answers[2].points) &&
          isDeepcutsPoints(request.resource.data.answers[3].points) &&
          isDeepcutsPoints(request.resource.data.answers[4].points) &&
          request.resource.data.score == request.resource.data.answers[0].points + request.resource.data.answers[1].points + request.resource.data.answers[2].points + request.resource.data.answers[3].points + request.resource.data.answers[4].points &&
          request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      // Lifetime statistics are available only to registered (non-anonymous) users.
      match /deepcutsStats/{statsId} {
        allow read: if request.auth != null && request.auth.uid == userId &&
          request.auth.token.firebase.sign_in_provider != 'anonymous';
        allow create, update: if request.auth != null &&
          request.auth.uid == userId && statsId == 'summary' &&
          request.auth.token.firebase.sign_in_provider != 'anonymous' &&
          request.resource.data.keys().hasOnly(['gamesPlayed', 'currentStreak', 'longestStreak', 'averageScore', 'bestScore', 'totalPoints', 'hundredPointAnswers', 'perfectGames', 'lastPlayedDate', 'updatedAt']) &&
          request.resource.data.gamesPlayed is int && request.resource.data.gamesPlayed > 0 &&
          request.resource.data.currentStreak is int && request.resource.data.currentStreak > 0 &&
          request.resource.data.longestStreak is int && request.resource.data.longestStreak >= request.resource.data.currentStreak &&
          request.resource.data.averageScore is int && request.resource.data.averageScore >= 0 && request.resource.data.averageScore <= 500 &&
          request.resource.data.bestScore is int && request.resource.data.bestScore >= 0 && request.resource.data.bestScore <= 500 &&
          request.resource.data.totalPoints is int && request.resource.data.totalPoints >= 0 &&
          request.resource.data.hundredPointAnswers is int && request.resource.data.hundredPointAnswers >= 0 &&
          request.resource.data.perfectGames is int && request.resource.data.perfectGames >= 0 &&
          existsAfter(/databases/$(database)/documents/users/$(userId)/deepcutsResults/$(request.resource.data.lastPlayedDate)) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

    }

    // Isolated Deepcuts namespace. Admin imports, private accepted answers,
    // challenge publication, and scoring must use the Admin SDK (which bypasses rules).
    match /footballDeepcuts/{document=**} {
      allow read, write: if false;
    }

    // Public, opt-in Deepcuts leaderboard. One immutable entry per UID and UTC date.
    match /deepcutsDailyLeaderboard/{entryId} {
      allow read: if true;
      allow create: if request.auth != null &&
        entryId == request.resource.data.date + '_' + request.auth.uid &&
        request.resource.data.keys().hasOnly(['userId', 'displayName', 'date', 'score', 'questionScores', 'registered', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 24 &&
        request.resource.data.date is string && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 500 &&
        request.resource.data.questionScores is list && request.resource.data.questionScores.size() == 5 &&
        isDeepcutsPoints(request.resource.data.questionScores[0]) &&
        isDeepcutsPoints(request.resource.data.questionScores[1]) &&
        isDeepcutsPoints(request.resource.data.questionScores[2]) &&
        isDeepcutsPoints(request.resource.data.questionScores[3]) &&
        isDeepcutsPoints(request.resource.data.questionScores[4]) &&
        request.resource.data.score == request.resource.data.questionScores[0] + request.resource.data.questionScores[1] + request.resource.data.questionScores[2] + request.resource.data.questionScores[3] + request.resource.data.questionScores[4] &&
        request.resource.data.registered == (request.auth.token.firebase.sign_in_provider != 'anonymous') &&
        request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/deepcutsResults/$(request.resource.data.date));
      allow update, delete: if false;
    }
    
    // Color Palettes collection
    // Document structure: /colorPalettes/{paletteId}
    // Fields: colors[], title, description, likes, createdBy, createdByName, createdAt, updatedAt
    // Security: Anyone can read, only authenticated users can create, only creator can update/delete
    match /colorPalettes/{paletteId} {
      // Anyone can read palettes (browse public palettes)
      allow read: if true;
      
      // Only authenticated users can create palettes
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      
      // Only the palette creator can delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
      
      // Only the palette creator can update
      allow update: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }
    
    // Pickup Soccer Games collection
    // Document structure: /games/{gameId}
    // Fields: title, description, date, time, location, maxPlayers, players[], createdBy, createdAt, updatedAt
    // Security: Anyone can read, only authenticated users can create, only creator can update/delete
    match /games/{gameId} {
      // Anyone can read games (view available games)
      allow read: if true;
      
      // New games have a bounded capacity and can initially include only their organizer.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy &&
        request.resource.data.maxPlayers is int && request.resource.data.maxPlayers >= 2 && request.resource.data.maxPlayers <= 100 &&
        request.resource.data.players is list &&
        (request.resource.data.players.size() == 0 || request.resource.data.players == [request.auth.uid]);
      
      // Only the game creator can delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
      
      // Allow game creator to update any field
      allow update: if request.auth != null && request.auth.uid == resource.data.createdBy &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.players == resource.data.players &&
        request.resource.data.maxPlayers is int &&
        request.resource.data.maxPlayers >= 2 && request.resource.data.maxPlayers <= 100 &&
        request.resource.data.players.size() <= request.resource.data.maxPlayers;
      
      // Allow any authenticated user to join/leave games (update players array only)
      // This allows users to add/remove themselves from the players array
      allow update: if request.auth != null && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'updatedAt']) &&
        request.resource.data.players is list &&
        resource.data.players is list &&
        request.resource.data.updatedAt == request.time &&
        (
          (!(request.auth.uid in resource.data.players) &&
           request.auth.uid in request.resource.data.players &&
           request.resource.data.players.size() == resource.data.players.size() + 1 &&
           request.resource.data.players.size() <= resource.data.maxPlayers &&
           request.resource.data.players.hasAll(resource.data.players)) ||
          (request.auth.uid in resource.data.players &&
           !(request.auth.uid in request.resource.data.players) &&
           resource.data.players.size() == request.resource.data.players.size() + 1 &&
           resource.data.players.hasAll(request.resource.data.players))
        );
    }
    
    // Secret Santa Exchanges collection
    // Document structure: /secretSantaExchanges/{exchangeId}
    // Fields: name, description, budget, exchangeDate, participants[], assignments{}, drawn, createdBy, createdByName, createdAt, updatedAt
    // Security: Anyone can read, only authenticated users can create, only creator can update/delete
    match /secretSantaExchanges/{exchangeId} {
      // Anyone can read exchanges (view available exchanges)
      allow read: if true;
      
      // Only authenticated users can create exchanges
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.createdBy &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 1 &&
        request.resource.data.participants[0] == request.auth.uid &&
        request.resource.data.drawn == false &&
        !request.resource.data.keys().hasAny(['assignments']);
      
      // Only the exchange creator can delete
      allow delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
      
      // The organizer may only close a draw. Assignments live in private child documents.
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.createdBy &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['drawn', 'updatedAt']) &&
        resource.data.drawn == false &&
        request.resource.data.drawn == true;

      // One-time migration from the legacy public assignment map.
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.createdBy &&
        resource.data.keys().hasAny(['assignments']) &&
        resource.data.assignments is map &&
        resource.data.assignments.size() > 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignments', 'updatedAt']) &&
        request.resource.data.assignments is map &&
        request.resource.data.assignments.size() == 0;

      // A participant may atomically add or remove only themselves before the draw.
      allow update: if request.auth != null &&
        resource.data.drawn == false &&
        request.resource.data.drawn == false &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participants', 'participantResponses', 'participantNames', 'updatedAt']) &&
        request.resource.data.participants is list &&
        resource.data.participants is list &&
        request.resource.data.participantResponses is map &&
        request.resource.data.participantNames is map &&
        ((!resource.data.keys().hasAny(['participantResponses']) &&
          request.resource.data.participantResponses.keys().hasOnly([request.auth.uid])) ||
         (resource.data.participantResponses is map &&
          request.resource.data.participantResponses.diff(resource.data.participantResponses)
            .affectedKeys().hasOnly([request.auth.uid]))) &&
        ((!resource.data.keys().hasAny(['participantNames']) &&
          request.resource.data.participantNames.keys().hasOnly([request.auth.uid])) ||
         (resource.data.participantNames is map &&
          request.resource.data.participantNames.diff(resource.data.participantNames)
            .affectedKeys().hasOnly([request.auth.uid]))) &&
        (
          (!(request.auth.uid in resource.data.participants) &&
           request.auth.uid in request.resource.data.participants &&
           request.resource.data.participants.size() == resource.data.participants.size() + 1 &&
           request.resource.data.participants.hasAll(resource.data.participants)) ||
          (request.auth.uid in resource.data.participants &&
           !(request.auth.uid in request.resource.data.participants) &&
           resource.data.participants.size() == request.resource.data.participants.size() + 1 &&
           resource.data.participants.hasAll(request.resource.data.participants))
        );

      match /assignments/{giverId} {
        // Each participant can read only their own result.
        allow read: if request.auth != null && request.auth.uid == giverId;

        // Assignment documents are created as part of the organizer's atomic draw.
        allow create: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/secretSantaExchanges/$(exchangeId)).data.createdBy &&
          giverId in get(/databases/$(database)/documents/secretSantaExchanges/$(exchangeId)).data.participants &&
          request.resource.data.keys().hasOnly(['receiverId']) &&
          request.resource.data.receiverId in get(/databases/$(database)/documents/secretSantaExchanges/$(exchangeId)).data.participants &&
          request.resource.data.receiverId != giverId;

        allow update: if false;
        allow delete: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/secretSantaExchanges/$(exchangeId)).data.createdBy;
      }
    }
    
    // Amer Gauntlet Daily Leaderboard collection
    // Document structure: /amerGauntletDailyLeaderboard/{date_userId}
    // Fields: userId, displayName, date, score, attempts, time, word, createdAt
    // Security: Anyone can read, only authenticated users can create/update their own entries
    match /amerGauntletDailyLeaderboard/{entryId} {
      // Anyone can read leaderboard entries
      allow read: if true;
      
      // Only authenticated users can create entries for themselves
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Only the user can update their own entry
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Users can delete their own entries
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Amer Gauntlet All-Time Leaderboard collection
    // Document structure: /amerGauntletAllTimeLeaderboard/{userId}
    // Fields: userId, displayName, totalScore, createdAt, updatedAt
    // Security: Anyone can read, only authenticated users can create/update their own entries
    match /amerGauntletAllTimeLeaderboard/{userId} {
      // Anyone can read leaderboard entries
      allow read: if true;
      
      // Only authenticated users can create entries for themselves
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Only the user can update their own entry
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // Users can delete their own entries
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
